LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-dashscope-api-key
LLM_MODEL=qwen3.8-27b
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
COMPLIANCE_MAX_BATCHES=8

# Existing MinerU service integration (normal business parsing is required)
PDF_TRANS_MINERU_URL=http://127.0.0.1:7100
PDF_TRANS_MINERU_BACKEND=hybrid-engine
# PDF_TRANS_MINERU_SERVER_URL=http://127.0.0.1:8000
# MINERU_API_KEY=

# Development/test only. Keep false in normal business deployments.
BID_CHECK_ALLOW_DOCX_FALLBACK=false
